<label>ট্রানজেকশন নাম্বার:</label>
<input type="text" id="trxid" required>

<label>হোয়াটসঅ্যাপ নাম্বার/লিংক:</label>
<input type="text" id="whatsappNumber" required>

<br><br>
<button type="button" onclick="submitOrder()">✅ অর্ডার সাবমিট</button>

<script>
  const priceList = {
    1: 210, 2: 410, 3: 510, 4: 710, 5: 910,
    6: 1010, 7: 1210, 8: 1410, 9: 1510,
    10: 1710, 11: 2910, 12: 2020
  };

  function updatePrice() {
    const qty = document.getElementById('quantity').value;
    document.getElementById('price').value = priceList[qty];
  }

  function showPaymentInfo() {
    const methods = ['bkash', 'nagad', 'rocket'];
    methods.forEach(id => {
      document.getElementById(id).style.display = 'none';
    });

    const selected = document.getElementById('paymentMethod').value;
    if (selected) {
      document.getElementById(selected).style.display = 'block';
    }
  }

  function submitOrder() {
    const qty = document.getElementById('quantity').value;
    const price = priceList[qty];
const method = document.getElementById('paymentMethod').value;
    const trx = document.getElementById('trxid').value;
    const wp = document.getElementById('whatsappNumber').value;

    const paymentText = {
      bkash: 'বিকাশ (01977281424)',
      nagad: 'নগদ (01915347910)',
      rocket: 'রকেট (01915347910)'
    };

    const message =
      `অর্ডার ডিটেইলস:\n\n` +
      `প্রোডাক্ট: কল গ্রুপ\n` +
      `পরিমাণ: qty পিস` +
      `মূল্য:{price} টাকা\n` +
      `পেমেন্ট মেথড: paymentText[method] || 'নির্বাচন হয়নি'` +
      `ট্রানজেকশন নাম্বার:{trx}\n` +
      `কাস্টমার হোয়াটসঅ্যাপ: wp`;

    const whatsappURL = `https://wa.me/8801977281424?text={encodeURIComponent(message)}`;
    window.open(whatsappURL, '_blank');
  }
</script>
